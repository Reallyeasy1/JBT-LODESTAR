# Copy this file to .env and fill in your values
# MySQL connection string — create a database named 'lodestar' first
DATABASE_URL="mysql://root:password@localhost:3306/lodestar"

# Optional: set to "mock" (default) or "vercel"
# "openai" is accepted as an alias for backwards compatibility
AI_PROVIDER="mock"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_API_KEY="sk-000000000"

# Demo event ID — must match the DEMO_EVENT_ID constant in prisma/seed.ts
NEXT_PUBLIC_DEMO_EVENT_ID="cle00000000000000000001"
