# Copy this file to .env and fill in your values
# MySQL connection string — create a database named 'lodestar' first
DATABASE_URL="mysql://root:password@localhost:3306/lodestar"

# AI provider — set to "mock" for local demo (no API key required), or "openai"/"anthropic" for real LLM
AI_PROVIDER="mock"

# Optional: enables /api/contact-ocr for card/badge OCR
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Demo event ID — used in README quick-start link; the route resolves from the URL path param.
# Must match the DEMO_EVENT_ID constant in prisma/seed.ts.
NEXT_PUBLIC_DEMO_EVENT_ID="cle00000000000000000001"
